// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  lastName  String?   @map("last_name")
  phone     String?
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders     Order[]
  wishlist   Wishlist?
  cartItems  CartItem[]
  addresses  Address[]

  @@map("users")
}

model Address {
  id         String   @id @default(cuid())
  street     String
  city       String
  postalCode String   @map("postal_code")
  country    String
  phone      String?
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Category {
  id          String    @id @default(cuid())
  namePl      String    @map("name_pl")
  nameEn      String    @map("name_en")
  descriptionPl String? @map("description_pl")
  descriptionEn String? @map("description_en")
  slug        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(cuid())
  namePl        String    @map("name_pl")
  nameEn        String    @map("name_en")
  descriptionPl String?   @db.Text @map("description_pl")
  descriptionEn String?   @db.Text @map("description_en")
  pricePln      Decimal   @map("price_pln") @db.Decimal(10, 2)
  priceEur      Decimal   @map("price_eur") @db.Decimal(10, 2)
  salePricePln  Decimal?  @map("sale_price_pln") @db.Decimal(10, 2)
  salePriceEur  Decimal?  @map("sale_price_eur") @db.Decimal(10, 2)
  stock         Int       @default(0)
  sku           String?   @unique
  slug          String    @unique
  categoryId    String    @map("category_id")
  sizes  Json?  @default("[]")
  colors Json?  @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images        Image[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  discounts     Discount[]

  @@map("products")
}

model Image {
  id        String   @id @default(cuid())
  url       String
  altPl     String?  @map("alt_pl")
  altEn     String?  @map("alt_en")
  productId String   @map("product_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("images")
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique @map("user_id")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String   @map("wishlist_id")
  productId  String   @map("product_id")
  createdAt  DateTime @default(now())
  updatedAt DateTime  @updatedAt

  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model CartItem {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  productId    String   @map("product_id")
  quantity     Int      @default(1)
  size         String?
  color        String?
  sessionToken String?  @map("session_token")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size, color])
  @@unique([sessionToken, productId, size, color])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(cuid())
  stripeSessionId String      @unique
  userId          String?     @map("user_id")
  status          OrderStatus @default(PENDING)
  totalPln        Decimal     @map("total_pln") @db.Decimal(10, 2)
  totalEur        Decimal     @map("total_eur") @db.Decimal(10, 2)
  discountId      String?     @map("discount_id")

  shippingEmail   String?     @map("shipping_email")
  shippingName    String?     @map("shipping_name")
  shippingPhone   String?     @map("shipping_phone")
  shippingAddress Json?       @map("shipping_address")
  shippingMethod  String?     @map("shipping_method")
  shippingCost    Decimal?    @map("shipping_cost") @db.Decimal(10, 2)

  // Faktura VAT
  isInvoiceRequested Boolean  @default(false) @map("is_invoice_requested")
  companyName        String?  @map("company_name")
  vatNumber          String?  @map("vat_number")
  billingAddress     Json?    @map("billing_address")

  // Inny adres dostawy
  isDifferentShippingAddress Boolean @default(false) @map("is_different_shipping_address")
  alternateShippingAddress   Json?   @map("alternate_shipping_address")

  language        String      @default("pl")

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discount        Discount?   @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  quantity  Int
  pricePln  Decimal  @map("price_pln") @db.Decimal(10, 2)
  priceEur  Decimal  @map("price_eur") @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Discount {
  id          String        @id @default(cuid())
  code        String        @unique
  namePl      String?       @map("name_pl")
  nameEn      String?       @map("name_en")
  type        DiscountType
  value       Decimal       @db.Decimal(10, 2)
  validFrom   DateTime      @map("valid_from")
  validUntil  DateTime?     @map("valid_until")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products    Product[]
  orders      Order[]

  @@map("discounts")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Role {
  USER
  ADMIN
}

model HeroSettings {
  id           String      @id @default(cuid())
  titlePl      String      @map("title")
  titleEn      String?     @map("title_en")
  subtitlePl   String?     @db.Text @map("subtitle")
  subtitleEn   String?     @db.Text @map("subtitle_en")
  buttonTextPl String      @default("Odkryj") @map("button_text")
  buttonTextEn String?     @map("button_text_en")
  link         String      @default("/shop")
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())
  
  images       HeroImage[]

  @@map("hero_settings")
}

model HeroImage {
  id        String       @id @default(cuid())
  imageUrl String       @map("image_url")
  order     Int          @default(0)
  heroSettingsId String  @map("hero_settings_id")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  heroSettings HeroSettings @relation(fields: [heroSettingsId], references: [id], onDelete: Cascade)

  @@map("hero_images")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  consent   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter")
}
